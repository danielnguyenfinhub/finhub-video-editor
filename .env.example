# Copy this file to .env.local and fill in real values. .env.local is
# gitignored; this .env.example file is the template that gets committed.
#
# ELEVENLABS_API_KEY is only read by scripts/generate-voiceover.mjs (a
# standalone Node script), never by a Remotion component. Component code is bundled for the browser,
# and Remotion's CLI exposes .env/.env.local to that bundle's process.env
# (see env-variables.mdx), so an API key referenced inside a .tsx file would
# ship inside the render output. Pre-generate assets with a script instead,
# save them to public/, and have components read the static file.

ELEVENLABS_API_KEY=

# scripts/providers.mjs (the MCP's audio, visuals and research ask/translate) and
# scripts/voice-video.mjs / visuals.mjs. Each feature needs only its own key.
GEMINI_API_KEY=
FAL_KEY=
PIXABAY_API_KEY=
PEXELS_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# The one exception: MapTilerScene reads this in a component, because the
# MapTiler SDK draws the map in the browser, so the key must be in the bundle.
# MapTiler keys are browser keys by design. Make a dedicated free key at
# https://cloud.maptiler.com (renders have no origin, so it can't be limited
# by domain) and keep an eye on its usage there.
REMOTION_MAPTILER_KEY=
