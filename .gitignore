node_modules
dist
.DS_Store
.env
.env.local

# Ignore the output video from Git but not videos you import into src/.
out

# Claude Chat skill bundle (built from chat-skill/ + .claude/skills/)
remotion-video-skill.zip

# Original recordings and MortgageReel render proxies (too large for GitHub):
# public/recordings/<id>/ holds each recording once, its words.json tracked; the
# videos/<slug>/ lines cover unmigrated and faceless videos. edit.json.bak is the
# review page's backup.
/public/recordings/*/*
!/public/recordings/*/words.json
/public/videos/*/*.bak
/public/4.1*.mp4
/public/videos/*/source.mp4
/public/videos/*/original.*

# Source library (scripts/library.mjs): binaries stay local, their
# <file>.meta.json, index.json and synonyms.json are tracked.
/public/library/*/*
!/public/library/*/*.meta.json

# Pixabay background music: the licence bars redistributing tracks on their
# own, so they stay local. public/music/README.md lists where to get each one.
/public/music/*.mp3

# Python bytecode from scripts/*.py
__pycache__/
/public/videos/*/foreground.webm
/public/videos/*/foreground.webm.part
/public/videos/*/voice/
/.omnivoice/

# Daniel's footage in, finished videos out (README "The short version"): the
# media stays local, only each folder's README.txt is tracked.
/1 - PUT FOOTAGE HERE/*
!/1 - PUT FOOTAGE HERE/README.txt
/2 - FINISHED VIDEOS/*
!/2 - FINISHED VIDEOS/README.txt

# Repowise index written by the repo-audit-tools skill (node .claude/skills/repo-audit-tools/scripts/audit.mjs)
/.repowise/

# Global RE listing videos (docs/agents/listing-video.md): the agent's listing
# folders in, finished videos out. Only the notes and the fill-in template are
# tracked: listings, photos and videos are real client material (public repo).
/3 - GLOBAL RE LISTINGS/*
!/3 - GLOBAL RE LISTINGS/README.txt
!/3 - GLOBAL RE LISTINGS/_TEMPLATE/
/4 - GLOBAL RE FINISHED VIDEOS/*
!/4 - GLOBAL RE FINISHED VIDEOS/README.txt
# Agent headshots are personal; business logos can be committed.
/public/businesses/*/agent-*.jpg
# Prepared listings (photos, voice, script) stay local.
/public/listings/
